{"id":"law-782a466a52","title":"中华人民共和国国籍法","shortTitle":"国籍法","category":"法律","division":"constitutional","domain":"c-rights","authority":"全国人民代表大会","promulgationDate":"1980-09-10","effectiveDate":"1980-09-10","status":"effective","interpretationOf":null,"articleCount":18,"sections":[],"articles":[{"id":"law-782a466a52-0001","number":1,"seq":0,"suffix":null,"slug":"1","displayNumber":"第一条","order":1,"path":[],"text":"中华人民共和国国籍的取得、丧失和恢复，都适用本法。","paragraphs":1,"chars":25,"partHeading":null},{"id":"law-782a466a52-0002","number":2,"seq":0,"suffix":null,"slug":"2","displayNumber":"第二条","order":2,"path":[],"text":"中华人民共和国是统一的多民族的国家，各民族的人都具有中国国籍。","paragraphs":1,"chars":31,"partHeading":null},{"id":"law-782a466a52-0003","number":3,"seq":0,"suffix":null,"slug":"3","displayNumber":"第三条","order":3,"path":[],"text":"中华人民共和国不承认中国公民具有双重国籍。","paragraphs":1,"chars":21,"partHeading":null},{"id":"law-782a466a52-0004","number":4,"seq":0,"suffix":null,"slug":"4","displayNumber":"第四条","order":4,"path":[],"text":"父母双方或一方为中国公民，本人出生在中国，具有中国国籍。","paragraphs":1,"chars":28,"partHeading":null},{"id":"law-782a466a52-0005","number":5,"seq":0,"suffix":null,"slug":"5","displayNumber":"第五条","order":5,"path":[],"text":"父母双方或一方为中国公民，本人出生在外国，具有中国国籍；但父母双方或一方为中国公民并定居在外国，本人出生时即具有外国国籍的，不具有中国国籍。","paragraphs":1,"chars":70,"partHeading":null},{"id":"law-782a466a52-0006","number":6,"seq":0,"suffix":null,"slug":"6","displayNumber":"第六条","order":6,"path":[],"text":"父母无国籍或国籍不明，定居在中国，本人出生在中国，具有中国国籍。","paragraphs":1,"chars":32,"partHeading":null},{"id":"law-782a466a52-0007","number":7,"seq":0,"suffix":null,"slug":"7","displayNumber":"第七条","order":7,"path":[],"text":"外国人或无国籍人，愿意遵守中国宪法和法律，并具有下列条件之一的，可以经申请批准加入中国国籍：\n一、中国人的近亲属；\n二、定居在中国的；\n三、有其它正当理由。","paragraphs":4,"chars":75,"partHeading":null},{"id":"law-782a466a52-0008","number":8,"seq":0,"suffix":null,"slug":"8","displayNumber":"第八条","order":11,"path":[],"text":"申请加入中国国籍获得批准的，即取得中国国籍；被批准加入中国国籍的，不得再保留外国国籍。","paragraphs":1,"chars":43,"partHeading":null},{"id":"law-782a466a52-0009","number":9,"seq":0,"suffix":null,"slug":"9","displayNumber":"第九条","order":12,"path":[],"text":"定居外国的中国公民，自愿加入或取得外国国籍的，即自动丧失中国国籍。","paragraphs":1,"chars":33,"partHeading":null},{"id":"law-782a466a52-0010","number":10,"seq":0,"suffix":null,"slug":"10","displayNumber":"第十条","order":13,"path":[],"text":"中国公民具有下列条件之一的，可以经申请批准退出中国国籍：\n一、外国人的近亲属；\n二、定居在外国的；\n三、有其它正当理由。","paragraphs":4,"chars":57,"partHeading":null},{"id":"law-782a466a52-0011","number":11,"seq":0,"suffix":null,"slug":"11","displayNumber":"第十一条","order":17,"path":[],"text":"申请退出中国国籍获得批准的，即丧失中国国籍。","paragraphs":1,"chars":22,"partHeading":null},{"id":"law-782a466a52-0012","number":12,"seq":0,"suffix":null,"slug":"12","displayNumber":"第十二条","order":18,"path":[],"text":"国家工作人员和现役军人，不得退出中国国籍。","paragraphs":1,"chars":21,"partHeading":null},{"id":"law-782a466a52-0013","number":13,"seq":0,"suffix":null,"slug":"13","displayNumber":"第十三条","order":19,"path":[],"text":"曾有过中国国籍的外国人，具有正当理由，可以申请恢复中国国籍；被批准恢复中国国籍的，不得再保留外国国籍。","paragraphs":1,"chars":51,"partHeading":null},{"id":"law-782a466a52-0014","number":14,"seq":0,"suffix":null,"slug":"14","displayNumber":"第十四条","order":20,"path":[],"text":"中国国籍的取得、丧失和恢复，除第九条规定的以外，必须办理申请手续。未满十八周岁的人，可由其父母或其他法定代理人代为办理申请。","paragraphs":1,"chars":62,"partHeading":null},{"id":"law-782a466a52-0015","number":15,"seq":0,"suffix":null,"slug":"15","displayNumber":"第十五条","order":21,"path":[],"text":"受理国籍申请的机关，在国内为当地市、县公安局，在国外为中国外交代表机关和领事机关。","paragraphs":1,"chars":41,"partHeading":null},{"id":"law-782a466a52-0016","number":16,"seq":0,"suffix":null,"slug":"16","displayNumber":"第十六条","order":22,"path":[],"text":"加入、退出和恢复中国国籍的申请，由中华人民共和国公安部审批。经批准的，由公安部发给证书。","paragraphs":1,"chars":44,"partHeading":null},{"id":"law-782a466a52-0017","number":17,"seq":0,"suffix":null,"slug":"17","displayNumber":"第十七条","order":23,"path":[],"text":"本法公布前，已经取得中国国籍的或已经丧失中国国籍的，继续有效。","paragraphs":1,"chars":31,"partHeading":null},{"id":"law-782a466a52-0018","number":18,"seq":0,"suffix":null,"slug":"18","displayNumber":"第十八条","order":24,"path":[],"text":"本法自公布之日起施行。","paragraphs":1,"chars":11,"partHeading":null}]}